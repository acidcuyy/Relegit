# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Adjust port and credentials based on your PostgreSQL setup (e.g. Laragon default port 5432 or 5433)
DATABASE_URL="postgresql://postgres:password@localhost:5432/relegit_db"

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# AI Model Service (Optional FastAPI ML service)
AI_SERVICE_URL=http://localhost:8000
